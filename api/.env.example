# Settings for the API and worker. In AWS, ECS sets these from Terraform.
AWS_REGION=us-east-2
S3_BUCKET=soundcanvas-media
SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/123456789012/soundcanvas-jobs.fifo

DB_HOST=soundcanvas-db.xxxxxxxx.us-east-2.rds.amazonaws.com
DB_USER=soundcanvas
DB_PASSWORD=change-me
DB_NAME=soundcanvas

# API only: the website allowed to call the API from a browser.
FRONTEND_ORIGIN=https://soundcanvas.vercel.app

# Worker only: internal service addresses (Cloud Map names in AWS).
CPP_CORE_URL=http://cpp-core.soundcanvas.local:8080
ML_URL=http://ml.soundcanvas.local:5000
AUDIO_PRODUCER_URL=http://audio-producer.soundcanvas.local:9001
