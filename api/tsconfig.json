{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "es2020"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@gateway/*": [
                "../gateway/src/*"
            ],
            "*": [
                "node_modules/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "../gateway/src/**/*.ts"
    ]
}