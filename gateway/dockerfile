# gateway - 1 image, 3 ways to run it:
#   API (default CMD), worker (npm run worker), migration once per deploy (npm run migrate)
# same code everywhere -> api + worker can't end up on different versions
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY migrations ./migrations
USER node
EXPOSE 4000
CMD ["npm", "run", "api"]
