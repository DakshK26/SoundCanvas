{
  "name": "soundcanvas-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL API and SQS job worker for SoundCanvas.",
  "scripts": {
    "build": "tsc",
    "api": "node dist/api.js",
    "worker": "node dist/worker.js",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/client-sqs": "^3.1138.0",
    "@aws-sdk/s3-presigned-post": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "graphql": "^16.14.2",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
