{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/next"
        },
        {
            "src": "api/**/*.py",
            "use": "@vercel/python",
            "config": {
                "runtime": "python3.9"
            }
        },
        {
            "src": "api/**/*.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/graphql",
            "dest": "/api/graphql"
        },
        {
            "src": "/v1/models/soundcanvas:predict",
            "dest": "/api/predict"
        },
        {
            "src": "/api/compose/generate",
            "dest": "/api/compose"
        },
        {
            "src": "/api/render/produce",
            "dest": "/api/render"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ],
    "env": {
        "PYTHON_PATH": "api",
        "SERVERLESS_MODE": "true"
    }
}